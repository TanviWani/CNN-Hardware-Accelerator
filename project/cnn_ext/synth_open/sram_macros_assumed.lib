/* ASSUMED behavioural timing/area model of the course SRAM macros - NOT from a real memory compiler.
   clk->dout 1.00 ns, setup 0.15 ns, hold 0.05 ns. Area: 1.5 kum2 (32x32), 5.0 kum2 (128x32). Replace with the real .lib. */
library(sram_macros_assumed) {
  time_unit : "1ns"; voltage_unit : "1V"; current_unit : "1uA"; pulling_resistance_unit : "1kohm";
  capacitive_load_unit(1, ff); leakage_power_unit : "1nW";
  nom_process : 1; nom_voltage : 1.1; nom_temperature : 25;
  default_max_transition : 1.0;
  type(bus5)  { base_type : array; data_type : bit; bit_width : 5;  bit_from : 4; bit_to : 0; }
  type(bus7)  { base_type : array; data_type : bit; bit_width : 7;  bit_from : 6; bit_to : 0; }
  type(bus32) { base_type : array; data_type : bit; bit_width : 32; bit_from : 31; bit_to : 0; }

  cell(sram_32x32_1r1w) {
    area : 1500;
    pin(clk0) { direction : input; clock : true; capacitance : 3.0; }
    pin(clk1) { direction : input; clock : true; capacitance : 3.0; }
    pin(csb0) { direction : input; capacitance : 2.0;
      timing() { related_pin : "clk0"; timing_type : setup_rising;
          rise_constraint(scalar) { values("0.15"); } fall_constraint(scalar) { values("0.15"); } }
        timing() { related_pin : "clk0"; timing_type : hold_rising;
          rise_constraint(scalar) { values("0.05"); } fall_constraint(scalar) { values("0.05"); } }
    }
    bus(addr0) { bus_type : bus5; direction : input; capacitance : 2.0;
      timing() { related_pin : "clk0"; timing_type : setup_rising;
          rise_constraint(scalar) { values("0.15"); } fall_constraint(scalar) { values("0.15"); } }
        timing() { related_pin : "clk0"; timing_type : hold_rising;
          rise_constraint(scalar) { values("0.05"); } fall_constraint(scalar) { values("0.05"); } }
    }
    bus(din0) { bus_type : bus32; direction : input; capacitance : 2.0;
      timing() { related_pin : "clk0"; timing_type : setup_rising;
          rise_constraint(scalar) { values("0.15"); } fall_constraint(scalar) { values("0.15"); } }
        timing() { related_pin : "clk0"; timing_type : hold_rising;
          rise_constraint(scalar) { values("0.05"); } fall_constraint(scalar) { values("0.05"); } }
    }
    pin(csb1) { direction : input; capacitance : 2.0;
      timing() { related_pin : "clk1"; timing_type : setup_rising;
          rise_constraint(scalar) { values("0.15"); } fall_constraint(scalar) { values("0.15"); } }
        timing() { related_pin : "clk1"; timing_type : hold_rising;
          rise_constraint(scalar) { values("0.05"); } fall_constraint(scalar) { values("0.05"); } }
    }
    bus(addr1) { bus_type : bus5; direction : input; capacitance : 2.0;
      timing() { related_pin : "clk1"; timing_type : setup_rising;
          rise_constraint(scalar) { values("0.15"); } fall_constraint(scalar) { values("0.15"); } }
        timing() { related_pin : "clk1"; timing_type : hold_rising;
          rise_constraint(scalar) { values("0.05"); } fall_constraint(scalar) { values("0.05"); } }
    }

    bus(dout1) { bus_type : bus32; direction : output; max_capacitance : 200;
      timing() { related_pin : "clk1"; timing_type : rising_edge;
        cell_rise(scalar) { values("1.00"); } cell_fall(scalar) { values("1.00"); }
        rise_transition(scalar) { values("0.10"); } fall_transition(scalar) { values("0.10"); } }
    }
  }
  cell(sram_128x32_1r1w) {
    area : 5000;
    pin(clk0) { direction : input; clock : true; capacitance : 3.0; }
    pin(clk1) { direction : input; clock : true; capacitance : 3.0; }
    pin(csb0) { direction : input; capacitance : 2.0;
      timing() { related_pin : "clk0"; timing_type : setup_rising;
          rise_constraint(scalar) { values("0.15"); } fall_constraint(scalar) { values("0.15"); } }
        timing() { related_pin : "clk0"; timing_type : hold_rising;
          rise_constraint(scalar) { values("0.05"); } fall_constraint(scalar) { values("0.05"); } }
    }
    bus(addr0) { bus_type : bus7; direction : input; capacitance : 2.0;
      timing() { related_pin : "clk0"; timing_type : setup_rising;
          rise_constraint(scalar) { values("0.15"); } fall_constraint(scalar) { values("0.15"); } }
        timing() { related_pin : "clk0"; timing_type : hold_rising;
          rise_constraint(scalar) { values("0.05"); } fall_constraint(scalar) { values("0.05"); } }
    }
    bus(din0) { bus_type : bus32; direction : input; capacitance : 2.0;
      timing() { related_pin : "clk0"; timing_type : setup_rising;
          rise_constraint(scalar) { values("0.15"); } fall_constraint(scalar) { values("0.15"); } }
        timing() { related_pin : "clk0"; timing_type : hold_rising;
          rise_constraint(scalar) { values("0.05"); } fall_constraint(scalar) { values("0.05"); } }
    }
    pin(csb1) { direction : input; capacitance : 2.0;
      timing() { related_pin : "clk1"; timing_type : setup_rising;
          rise_constraint(scalar) { values("0.15"); } fall_constraint(scalar) { values("0.15"); } }
        timing() { related_pin : "clk1"; timing_type : hold_rising;
          rise_constraint(scalar) { values("0.05"); } fall_constraint(scalar) { values("0.05"); } }
    }
    bus(addr1) { bus_type : bus7; direction : input; capacitance : 2.0;
      timing() { related_pin : "clk1"; timing_type : setup_rising;
          rise_constraint(scalar) { values("0.15"); } fall_constraint(scalar) { values("0.15"); } }
        timing() { related_pin : "clk1"; timing_type : hold_rising;
          rise_constraint(scalar) { values("0.05"); } fall_constraint(scalar) { values("0.05"); } }
    }

    bus(dout1) { bus_type : bus32; direction : output; max_capacitance : 200;
      timing() { related_pin : "clk1"; timing_type : rising_edge;
        cell_rise(scalar) { values("1.00"); } cell_fall(scalar) { values("1.00"); }
        rise_transition(scalar) { values("0.10"); } fall_transition(scalar) { values("0.10"); } }
    }
  }
}
