function(require_questa_2026)
  execute_process(COMMAND "${VLOG}" -version OUTPUT_VARIABLE _version
    ERROR_VARIABLE _version_error)
  if(NOT "${_version}${_version_error}" MATCHES "vlog +2026\\.")
    message(FATAL_ERROR "This project requires Questa 2026. Source setup.sh, then clear cached VLOG/VSIM/VLIB paths with -U VLOG -U VSIM -U VLIB.")
  endif()
endfunction()

# Select the DPI SDK and a C++17-capable 64-bit compiler from the selected vlog.
function(configure_questa_dpi)
  find_program(VLOG vlog REQUIRED)
  require_questa_2026()
  get_filename_component(_vlog_real "${VLOG}" REALPATH)
  get_filename_component(_root "${_vlog_real}" DIRECTORY)
  set(_found FALSE)
  foreach(_level RANGE 0 4)
    if(EXISTS "${_root}/include/svdpi.h" AND EXISTS "${_root}/modelsim.ini")
      set(_found TRUE)
      break()
    endif()
    get_filename_component(_root "${_root}" DIRECTORY)
  endforeach()
  if(NOT _found)
    message(FATAL_ERROR "Cannot locate the Questa installation containing VLOG=${VLOG}")
  endif()
  set(DPI_INCLUDE_DIR "${_root}/include" CACHE PATH "DPI headers from selected vlog" FORCE)
  file(GLOB _candidates "${_root}/gcc-*x86_64/bin/g++")
  list(SORT _candidates COMPARE NATURAL ORDER DESCENDING)
  # Re-evaluate automatic and legacy bundled selections on every configure.
  # A compiler outside the bundled gcc directories is an explicit override.
  if(DPI_CXX AND NOT DPI_CXX STREQUAL _QUESTA_AUTO_DPI_CXX
      AND NOT DPI_CXX MATCHES "/gcc-[^/]+/bin/g\\+\\+$")
    set(_candidates "${DPI_CXX}")
    set(_override TRUE)
  else()
    set(_override FALSE)
  endif()
  file(WRITE "${CMAKE_BINARY_DIR}/dpi-cxx17-check.cpp"
    "#if __cplusplus < 201703L\n#error C++17 required\n#endif\nint main() {}\n")
  set(_compiler "")
  foreach(_candidate IN LISTS _candidates)
    execute_process(COMMAND "${_candidate}" -m64 -std=c++17 -fsyntax-only
      "${CMAKE_BINARY_DIR}/dpi-cxx17-check.cpp"
      RESULT_VARIABLE _status OUTPUT_QUIET ERROR_QUIET)
    if(_status EQUAL 0)
      set(_compiler "${_candidate}")
      break()
    endif()
  endforeach()
  if(NOT _compiler)
    message(FATAL_ERROR "No C++17-capable 64-bit DPI compiler found for VLOG=${VLOG}. Set DPI_CXX to a compatible compiler explicitly.")
  endif()
  set(DPI_CXX "${_compiler}" CACHE FILEPATH "C++ compiler for selected Questa installation" FORCE)
  if(NOT _override)
    set(_QUESTA_AUTO_DPI_CXX "${_compiler}" CACHE INTERNAL "Last automatically selected DPI compiler" FORCE)
  endif()
  set(QUESTA_ROOT "${_root}" PARENT_SCOPE)
  message(STATUS "Questa vlog: ${VLOG}")
  message(STATUS "Questa installation: ${_root}")
  message(STATUS "DPI compiler: ${_compiler}")
endfunction()
